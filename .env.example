APP_NAME=Vantage
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Local development uses SQLite by default; no database server required.
DATABASE_URL=sqlite+aiosqlite:///./data/vantage.db
# PostgreSQL remains supported for later environments, e.g.:
# DATABASE_URL=postgresql+asyncpg://vantage:vantage@localhost:5432/vantage
REDIS_URL=
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
EMBEDDING_DIMENSIONS=32
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
DEV_USER_EMAIL=analyst@example.local
DEV_USER_NAME=Vantage Analyst
REQUEST_BODY_LIMIT_BYTES=1048576
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000