# Copy this file to .env and adjust as needed. Never commit the real .env.
# Every variable below has a working default for local, mock-mode development --
# you do not need to set anything to run Vantage locally.

APP_NAME=Vantage
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local development uses SQLite by default; no database server required.
DATABASE_URL=sqlite+aiosqlite:///./data/vantage.db
# A normal (non-serverless) PostgreSQL server also works as-is:
# DATABASE_URL=postgresql+asyncpg://vantage:vantage@localhost:5432/vantage
#
# For a serverless/transaction-pooled PostgreSQL provider (e.g. Supabase's pooler),
# point DATABASE_URL at its pooler connection string and set DATABASE_SERVERLESS=true
# below -- no provider-specific code path, this is standard SQLAlchemy/asyncpg config
# (NullPool + disabled prepared-statement cache) applied to any transaction pooler:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<pooler-host>:<port>/<database>
DATABASE_SERVERLESS=false

# --- Providers ---------------------------------------------------------------
# mock (default): fully deterministic, no network calls, no credentials needed.
# azure_openai: real Azure OpenAI calls; requires the AZURE_OPENAI_* values below.
# gemini: real Google Gemini calls (google-genai SDK); requires GEMINI_API_KEY below.
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Only required when LLM_PROVIDER=azure_openai and/or EMBEDDING_PROVIDER=azure_openai.
# Leave blank in mock mode. Never commit real values here.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Optional: only some embedding models (e.g. text-embedding-3-*) support truncating
# to a smaller dimension count. Leave blank to use the model's native dimension.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=

# Only required when LLM_PROVIDER=gemini and/or EMBEDDING_PROVIDER=gemini.
# Leave blank in mock mode. Never commit a real value here.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Dimension used by the mock embedding provider only.
EMBEDDING_DIMENSIONS=32

# --- Ingestion -----------------------------------------------------------------
INGESTION_CONNECT_TIMEOUT_SECONDS=5.0
INGESTION_READ_TIMEOUT_SECONDS=15.0
INGESTION_MAX_RETRIES=2
INGESTION_RETRY_BACKOFF_SECONDS=0.5
INGESTION_MAX_DISCOVERED_PAGES=10
INGESTION_MIN_CONTENT_LENGTH_FOR_BROWSER=200
# Playwright browser fallback for JS-heavy pages. Requires `playwright install chromium`
# to actually work; leave false unless you have installed the browser binaries.
# Always false in the AWS Lambda deployment (see apps/api/app/lambda_handler.py) --
# Playwright's browser binaries are never bundled into the Lambda package.
ENABLE_BROWSER_FALLBACK=false

# --- Scheduling ------------------------------------------------------------
# In-process only (APScheduler) -- no Redis, no Celery, no separate worker process.
# Always disabled automatically when APP_ENV=test, regardless of this flag.
# Always false in the AWS Lambda deployment: an in-process scheduler has no meaning in
# a request-driven serverless function and must not create background behavior there.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=60

LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Deterministic local development identity; no login flow yet.
DEV_USER_EMAIL=analyst@example.local
DEV_USER_NAME=Vantage Analyst
DEV_WORKSPACE_NAME=Vantage Development
DEV_WORKSPACE_SLUG=development

REQUEST_BODY_LIMIT_BYTES=1048576
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Production (AWS Lambda) reference values ---------------------------------
# Not used locally. Documented here so the required production shape is visible in one
# place. Set these as the Lambda function's own environment variables, never in this
# repository -- see apps/api/app/lambda_handler.py and
# .github/workflows/deploy-api-lambda.yml.
# APP_ENV=production
# ENABLE_SCHEDULER=false
# ENABLE_BROWSER_FALLBACK=false
# DATABASE_SERVERLESS=true
